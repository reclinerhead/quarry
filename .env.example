# Copy to .env (never committed) or set in the shell / systemd environment file.

# The SQLite file Jasper creates and the web app reads. Both processes must see
# the same path. Default: data/quarry.db under the repo.
QUARRY_DB=data/quarry.db

# Where photos and their thumbnails live (photos/). Default: data/
QUARRY_DATA=data

# Vercel AI Gateway key, for identification (#7). Jasper only; the web app
# never calls a model. The same key reaches every provider's models.
AI_GATEWAY_API_KEY=

# The two models Jasper asks (#7), as gateway slugs. Phase 0 (#1) chose these.
#QUARRY_IDENTIFIER=anthropic/claude-haiku-5.5
#QUARRY_SECOND_OPINION=google/gemini-3.8-flash
