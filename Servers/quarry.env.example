# The Quarry on orchid or a station: /etc/quarry/quarry.env
# Root-owned, mode 0600. Read by all three units through EnvironmentFile=.
# Never in the repo; the box's install script (Servers/install-orchid.sh, or
# Servers/install-station.sh on a station) copies this example into place when
# the file does not exist yet, and asks for the gateway key to put in it.

# The one SQLite file, created and migrated by Jasper (the install script
# creates it the first time, so the web app has a database before Jasper's
# first job). Outside the checkout, so a deploy can never touch it.
QUARRY_DB=/home/todd/quarry-data/quarry.db

# The photo tree: photos/yyyy/mm/<uuid>.<ext> and Jasper's .thumb.jpg beside each.
QUARRY_DATA=/home/todd/quarry-data

# Vercel AI Gateway key (https://vercel.com/ai-gateway). Jasper only; the web
# app never calls a model. Jasper will not start without it.
AI_GATEWAY_API_KEY=

# The two models Jasper asks, as gateway slugs. Unset means these.
#QUARRY_IDENTIFIER=anthropic/claude-haiku-5.5
#QUARRY_SECOND_OPINION=google/gemini-3.8-flash

# OpenMindat API key (mindat.org). Jasper only, and optional: without it
# candidates are matched by name only. The install script asks for it.
MINDAT_API_KEY=

# The branch the deploy watcher follows (#101). Orchid leaves this unset and
# follows main. A station follows quarry-station-stable, the release channel:
# main with a delay, moved to main's tip once nightly. install-station.sh
# writes this line; the checkout must sit on the same branch.
#QUARRY_DEPLOY_BRANCH=quarry-station-stable

# Not here: NEXT_PUBLIC_BASE_PATH, the path the web app is served under on a
# station (/quarry, #100). It is a build-time value, read from web/.env.local
# (owned by todd, written by install-station.sh), because the build runs as
# todd, who cannot read this file. Orchid has no such file.
