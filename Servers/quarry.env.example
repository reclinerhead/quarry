# The Quarry on orchid: /etc/quarry/quarry.env
# Root-owned, mode 0600. Read by both units through EnvironmentFile=. Never
# in the repo; Servers/install-orchid.sh copies this example into place when
# the file does not exist yet, and asks which gateway key to put in it.

# The one SQLite file, created and migrated by Jasper (the install script
# creates it the first time, so the web app has a database before Jasper's
# first job). Outside the checkout, so a deploy can never touch it.
QUARRY_DB=/home/todd/quarry-data/quarry.db

# The photo tree: photos/yyyy/mm/<uuid>.<ext> and Jasper's .thumb.jpg beside each.
QUARRY_DATA=/home/todd/quarry-data

# Vercel AI Gateway key (https://vercel.com/ai-gateway). Jasper only; the web
# app never calls a model. Jasper will not start without it.
AI_GATEWAY_API_KEY=

# The two models Jasper asks, as gateway slugs. Unset means these.
#QUARRY_IDENTIFIER=anthropic/claude-haiku-5.5
#QUARRY_SECOND_OPINION=google/gemini-3.8-flash

# OpenMindat API key (mindat.org). Jasper only, and optional: without it
# candidates are matched by name only. The install script asks for it.
MINDAT_API_KEY=
